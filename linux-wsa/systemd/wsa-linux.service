[Unit]
Description=Windows Subsystem for Android (WSA) on Linux
Documentation=https://github.com/MustardChef/WSABuilds
After=graphical-session.target network.target sound.target

[Service]
Type=forking
ExecStart=/usr/local/bin/wsa-client start --daemon
ExecStop=/usr/local/bin/wsa-client stop
Restart=on-failure
RestartSec=5s
PIDFile=%t/wsa-linux/wsa.pid
TimeoutStopSec=30s

[Install]
WantedBy=default.target
