#!/usr/bin/env python3
"""
WSA Settings & Configuration Manager for Linux (Fedora & Ubuntu)
Provides both Graphical (Tkinter) and Terminal (CLI/TUI) interfaces
to configure the Linux Subsystem for Android.
"""

import os
import sys
import subprocess
from pathlib import Path

CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "wsa-linux"
CONFIG_FILE = CONFIG_DIR / "wsa-linux.conf"
DATA_DIR = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / "wsa-linux"

DEFAULTS = {
    "WSA_CPUS": "4",
    "WSA_RAM": "4G",
    "WSA_USERDATA_SIZE": "16G",
    "WSA_DISPLAY": "auto",
    "WSA_GL": "on",
    "WSA_ADB_PORT": "5555",
    "WSA_SHARE_DIR": str(Path.home() / "AndroidShare"),
    "WSA_SEAMLESS": "auto",
}

def load_config():
    config = dict(DEFAULTS)
    if CONFIG_FILE.is_file():
        with open(CONFIG_FILE, "r") as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    k, v = line.split("=", 1)
                    config[k.strip()] = v.strip().strip('"').strip("'")
    return config

def save_config(config):
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    with open(CONFIG_FILE, "w") as f:
        f.write("# WSA Linux Subsystem Configuration File\n")
        f.write("# Generated by wsa-settings\n\n")
        for k, v in config.items():
            f.write(f'{k}="{v}"\n')
    print(f"[+] Configuration saved to {CONFIG_FILE}")

def run_cmd(args):
    try:
        subprocess.run(args, check=False)
    except Exception as e:
        print(f"Error running {args}: {e}")

def run_gui():
    try:
        import tkinter as tk
        from tkinter import ttk, messagebox, filedialog
    except ImportError:
        print("[!] Tkinter not available, falling back to CLI interface.")
        run_cli()
        return

    root = tk.Tk()
    root.title("WSA Settings - Linux Subsystem for Android")
    root.geometry("520x540")
    root.resizable(False, False)

    config = load_config()

    # Style
    style = ttk.Style(root)
    style.theme_use("clam")

    notebook = ttk.Notebook(root)
    notebook.pack(fill="both", expand=True, padx=10, pady=10)

    # Tab 1: Hardware & Performance
    tab_hw = ttk.Frame(notebook, padding=10)
    notebook.add(tab_hw, text="Hardware")

    ttk.Label(tab_hw, text="CPU Cores:").grid(row=0, column=0, sticky="w", pady=6)
    cpu_var = tk.StringVar(value=config.get("WSA_CPUS", "4"))
    cpu_combo = ttk.Combobox(tab_hw, textvariable=cpu_var, values=["2", "4", "6", "8", "12", "16"], width=10)
    cpu_combo.grid(row=0, column=1, sticky="e", pady=6)

    ttk.Label(tab_hw, text="Memory (RAM):").grid(row=1, column=0, sticky="w", pady=6)
    ram_var = tk.StringVar(value=config.get("WSA_RAM", "4G"))
    ram_combo = ttk.Combobox(tab_hw, textvariable=ram_var, values=["2G", "4G", "6G", "8G", "12G", "16G"], width=10)
    ram_combo.grid(row=1, column=1, sticky="e", pady=6)

    ttk.Label(tab_hw, text="User Data Disk Size:").grid(row=2, column=0, sticky="w", pady=6)
    data_var = tk.StringVar(value=config.get("WSA_USERDATA_SIZE", "16G"))
    data_combo = ttk.Combobox(tab_hw, textvariable=data_var, values=["8G", "16G", "32G", "64G", "128G"], width=10)
    data_combo.grid(row=2, column=1, sticky="e", pady=6)

    ttk.Label(tab_hw, text="Display Window Mode:").grid(row=3, column=0, sticky="w", pady=6)
    disp_var = tk.StringVar(value=config.get("WSA_DISPLAY", "auto"))
    disp_combo = ttk.Combobox(tab_hw, textvariable=disp_var, values=["auto", "gtk", "sdl", "headless"], width=10)
    disp_combo.grid(row=3, column=1, sticky="e", pady=6)

    ttk.Label(tab_hw, text="3D Hardware Acceleration (VirGL):").grid(row=4, column=0, sticky="w", pady=6)
    gl_var = tk.StringVar(value=config.get("WSA_GL", "on"))
    gl_combo = ttk.Combobox(tab_hw, textvariable=gl_var, values=["on", "off"], width=10)
    gl_combo.grid(row=4, column=1, sticky="e", pady=6)

    # Tab 2: Integration & Storage
    tab_int = ttk.Frame(notebook, padding=10)
    notebook.add(tab_int, text="Integration")

    ttk.Label(tab_int, text="ADB Port:").grid(row=0, column=0, sticky="w", pady=6)
    adb_var = tk.StringVar(value=config.get("WSA_ADB_PORT", "5555"))
    ttk.Entry(tab_int, textvariable=adb_var, width=12).grid(row=0, column=1, sticky="e", pady=6)

    ttk.Label(tab_int, text="Shared Folder:").grid(row=1, column=0, sticky="w", pady=6)
    share_var = tk.StringVar(value=config.get("WSA_SHARE_DIR", str(Path.home() / "AndroidShare")))
    share_entry = ttk.Entry(tab_int, textvariable=share_var, width=28)
    share_entry.grid(row=2, column=0, columnspan=2, sticky="ew", pady=4)
    def browse_dir():
        d = filedialog.askdirectory(initialdir=share_var.get())
        if d:
            share_var.set(d)
    ttk.Button(tab_int, text="Browse...", command=browse_dir).grid(row=3, column=1, sticky="e", pady=4)

    # Tab 3: Management & Actions
    tab_act = ttk.Frame(notebook, padding=10)
    notebook.add(tab_act, text="Quick Actions")

    script_dir = Path(__file__).resolve().parent

    ttk.Button(tab_act, text="▶ Start WSA Android Subsystem",
               command=lambda: run_cmd([str(script_dir / "wsa-client"), "start", "--daemon"])).pack(fill="x", pady=4)
    ttk.Button(tab_act, text="⏹ Stop Android Subsystem",
               command=lambda: run_cmd([str(script_dir / "wsa-client"), "stop"])).pack(fill="x", pady=4)
    ttk.Button(tab_act, text="🛒 Open Google Play Store",
               command=lambda: run_cmd([str(script_dir / "wsa-client"), "play"])).pack(fill="x", pady=4)
    ttk.Button(tab_act, text="⚡ Open Magisk Manager (Root)",
               command=lambda: run_cmd([str(script_dir / "wsa-client"), "magisk"])).pack(fill="x", pady=4)
    ttk.Button(tab_act, text="🔄 Synchronize Apps to Linux Menu",
               command=lambda: run_cmd([str(script_dir / "wsa-client"), "sync-apps"])).pack(fill="x", pady=4)

    # Bottom Buttons
    btn_frame = ttk.Frame(root, padding=10)
    btn_frame.pack(fill="x", side="bottom")

    def on_save():
        config["WSA_CPUS"] = cpu_var.get()
        config["WSA_RAM"] = ram_var.get()
        config["WSA_USERDATA_SIZE"] = data_var.get()
        config["WSA_DISPLAY"] = disp_var.get()
        config["WSA_GL"] = gl_var.get()
        config["WSA_ADB_PORT"] = adb_var.get()
        config["WSA_SHARE_DIR"] = share_var.get()
        save_config(config)
        messagebox.showinfo("WSA Settings", "Configuration saved successfully!\nRestart WSA for changes to take effect.")

    ttk.Button(btn_frame, text="Save & Apply", command=on_save).pack(side="right", padx=5)
    ttk.Button(btn_frame, text="Close", command=root.destroy).pack(side="right")

    root.mainloop()

def run_cli():
    config = load_config()
    print("==================================================")
    print(" WSA Linux Subsystem Settings (CLI)")
    print("==================================================")
    for k, v in config.items():
        print(f"  {k} = {v}")
    print("==================================================")
    print("Config file location:", CONFIG_FILE)
    print("To modify, edit the config file or launch in a desktop environment with GUI support.")

if __name__ == "__main__":
    if "--cli" in sys.argv or not os.environ.get("DISPLAY") and not os.environ.get("WAYLAND_DISPLAY"):
        run_cli()
    else:
        run_gui()
